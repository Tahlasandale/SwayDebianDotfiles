+    end
+    if type(char) ~= "string" then
+        return false
+    end
+    local cursor = bp.Cursor
+    local line = bp.Buf:Line(cursor.Y)
+    local ahead = string.sub(line, cursor.X + 1, cursor.X + 1)
+    if (char == "]" or char == ")") and (ahead == "]" or ahead == ")") then
+        bp:Backspace()
