// Catppuccin Mocha

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "source": "~/.config/fastfetch/logo/catppuccin_logo.png",
    "width": 40,
    "padding": {
      "top": 2,
      "left": 2,
      "right": 2,
    },
  },
  "display": {
    "separator": " \u001b[38;2;203;166;247m\u001b[0m ",
    "constants": [
      "\u001b[38;2;242;205;205m─────────────────\u001b[0m", // {$1}, used in Custom module
    ],
    "key": {
      "type": "icon",
      "paddingLeft": 2,
    },
  },
  "modules": [
    {
      "type": "custom", // HardwareStart
      // {#1} is equivalent to `\u001b[1m`. {#} is equivalent to `\u001b[m`
      "format": "\u001b[38;2;242;205;205m┌\u001b[0m{$1} \u001b[38;2;203;166;247mHardware Information\u001b[0m {$1}\u001b[38;2;242;205;205m┐\u001b[0m",
    },
    {
      "type": "host",
      "keyColor": "\u001b[38;2;245;194;231m",
    },
    {
      "type": "cpu",
      "keyColor": "\u001b[38;2;245;194;231m",
    },
    {
      "type": "gpu",
      "keyColor": "\u001b[38;2;245;194;231m",
    },
    {
      "type": "disk",
      "keyColor": "\u001b[38;2;245;194;231m",
    },
    {
      "type": "memory",
      "keyColor": "\u001b[38;2;245;194;231m",
    },
    {
      "type": "display",
      "keyColor": "\u001b[38;2;245;194;231m",
    },
    {
      "type": "custom", // InformationEnd
      "format": "\u001b[38;2;242;205;205m└\u001b[0m{$1}\u001b[38;2;242;205;205m──────────────────────\u001b[0m{$1}\u001b[38;2;242;205;205m┘\u001b[0m",
    },
    {
      "type": "custom", // Separator
      "format": "",
    },
    {
      "type": "custom", // SoftwareStart
      "format": "\u001b[38;2;242;205;205m┌\u001b[0m{$1} \u001b[38;2;203;166;247mSoftware Information\u001b[0m {$1}\u001b[38;2;242;205;205m┐\u001b[0m",
    },
    {
      "type": "os",
      "keyColor": "\u001b[38;2;245;194;231m",
    },
    {
      "type": "kernel",
      "keyColor": "\u001b[38;2;245;194;231m",
    },
    {
      "type": "lm",
      "keyColor": "\u001b[38;2;245;194;231m",
    },
    {
      "type": "de",
      "keyColor": "\u001b[38;2;245;194;231m",
    },
    {
      "type": "wm",
      "keyColor": "\u001b[38;2;245;194;231m",
    },
    {
      "type": "shell",
      "keyColor": "\u001b[38;2;245;194;231m",
    },
    {
      "type": "terminal",
      "keyColor": "\u001b[38;2;245;194;231m",
    },
    {
      "type": "font",
      "keyColor": "\u001b[38;2;245;194;231m",
    },
    {
      "type": "theme",
      "keyColor": "\u001b[38;2;245;194;231m",
    },
    {
      "type": "icons",
      "keyColor": "\u001b[38;2;245;194;231m",
    },
    {
      "type": "packages",
      "keyColor": "\u001b[38;2;245;194;231m",
    },
    {
      "type": "uptime",
      "keyColor": "\u001b[38;2;245;194;231m",
    },
    {
      "type": "command",
      "key": " Boot",
      "keyColor": "\u001b[38;2;245;194;231m",
      "text": "~/.local/bin/boot-info.sh",
    },
    {
      "type": "locale",
      "keyColor": "\u001b[38;2;245;194;231m",
    },
    {
      "type": "custom", // InformationEnd
      "format": "\u001b[38;2;242;205;205m└\u001b[0m{$1}\u001b[38;2;242;205;205m──────────────────────\u001b[0m{$1}\u001b[38;2;242;205;205m┘\u001b[0m",
    },
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 21,
    },
  ],
}
