include catppuccin-mocha
# --- CONFIGURATION SWAY POUR DEBIAN 13 (BISON) ---

# Variables par défaut
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term foot
set $menu /home/bison/.local/bin/tofi-drun

# --- Theme Catppuccin Mocha (bordures) ---
# target              title     bg    text   indicator  border
client.focused          $pink $base $text  $rosewater $pink
client.focused_inactive $sky $base $text  $rosewater $sky
client.unfocused        $sky $base $text  $rosewater $sky
client.urgent           $peach    $base $peach $overlay0  $peach
client.placeholder      $overlay0 $base $text  $overlay0  $overlay0
client.background       $base

# Liseres 5px Mocha (pas de barre de titre) : focus $pink, inactives $sky
default_border pixel 5

# Clavier en Français (AZERTY)
input * {
    xkb_layout "fr"
}

# Trackpad ELAN : scroll naturel (2 doigts), tap = clic, 2 doigts = clic droit
input type:touchpad {
    natural_scroll enabled
    tap enabled
    click_method clickfinger
}

# Inclure les configurations par défaut de Debian (raccourcis médias, polkit, etc.)
include /etc/sway/config.d/*

# Variables d'environnement essentielles pour Wayland (Firefox, Qt, Écran)
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
exec systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP

# Fond de secours persistant (restaure a chaque reload/login, la rotation l'ecrase au runtime)
output * bg ~/Images/waves.png fill

# Wallpaper aleatoire a l'ouverture de session
exec ~/.local/bin/sway-next-wallpaper.sh

# Verr Maj actif par defaut (touche utilisable pour deverrouiller)
exec sh -c 'sleep 2; wtype -k Caps_Lock'
exec mako

# Waybar en overlay flottant (standalone, Sway ne reserve aucun espace)
exec waybar

# --- RACCOURCIS CLAVIER ---

# Raccourcis de base
bindsym $mod+Return exec $term
bindsym $mod+w kill
bindsym $mod+space exec $menu
bindsym $mod+exclam exec ~/.local/bin/sway-next-wallpaper.sh
bindsym $mod+Shift+e exec swaynag -t warning -m 'Voulez-vous quitter Sway ?' -B 'Oui, quitter' 'swaymsg exit'

# Déplacer le focus (touches fléchées ou hjkl)
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Changement de bureau circulaire (1-2-3-4-5-1) au clavier
bindsym Control+$mod+Left exec ~/.local/bin/sway-cycle-workspace.sh prev
bindsym Control+$mod+Right exec ~/.local/bin/sway-cycle-workspace.sh next

# Déplacer la fenêtre active
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Gestion des Workspaces (Bureaux virtuels 1 à 5)
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5

# Gestures trackpad : 3 doigts = bureau circulaire
bindgesture swipe:3:left exec ~/.local/bin/sway-cycle-workspace.sh next
bindgesture swipe:3:right exec ~/.local/bin/sway-cycle-workspace.sh prev
# Doublons pave numerique (KP_1..KP_5, Verr Num actif)
bindsym $mod+KP_1 workspace number 1
bindsym $mod+KP_2 workspace number 2
bindsym $mod+KP_3 workspace number 3
bindsym $mod+KP_4 workspace number 4
bindsym $mod+KP_5 workspace number 5

# Déplacer la fenêtre vers un Workspace
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+KP_1 move container to workspace number 1
bindsym $mod+Shift+KP_2 move container to workspace number 2
bindsym $mod+Shift+KP_3 move container to workspace number 3
bindsym $mod+Shift+KP_4 move container to workspace number 4
bindsym $mod+Shift+KP_5 move container to workspace number 5

# Mise en page (Layouts)
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle

# Recharger la configuration

bindsym $mod+Shift+r reload

# Syncthing : DOIT rester le tout dernier exec du fichier,
# afin de demarrer en derniere priorite apres tout l'environnement
# (env dbus/systemd, papier peint, caps lock, waybar).
# Ne rien ajouter apres cette ligne.
exec sh -c 'sleep 3; ~/.local/bin/syncthing serve'
