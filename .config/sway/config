include catppuccin-mocha
# --- CONFIGURATION SWAY POUR DEBIAN 13 (BISON) ---

# Variables par défaut
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term foot
set $menu /home/bison/.local/bin/tofi-drun

# --- Theme Catppuccin Mocha (bordures) ---
# target              title     bg    text   indicator  border
client.focused          $pink $base $text  $rosewater $pink
client.focused_inactive $sky $base $text  $rosewater $sky
client.unfocused        $sky $base $text  $rosewater $sky
client.urgent           $peach    $base $peach $overlay0  $peach
client.placeholder      $overlay0 $base $text  $overlay0  $overlay0
client.background       $base

# Liseres 5px Mocha (pas de barre de titre) : focus $pink, inactives $sky
default_border pixel 5

# Clavier en Français (AZERTY)
input * {
    xkb_layout "fr"
    xkb_numlock enabled
}

# Trackpad ELAN : scroll naturel (2 doigts), tap = clic, 2 doigts = clic droit
input type:touchpad {
    natural_scroll enabled
    tap enabled
    click_method clickfinger
    pointer_accel 0.4
}

# --- Theme de Curseur (Bibata Modern Catppuccin Sky / Cyan 40px) ---
seat * xcursor_theme Bibata-Modern-Sky 40

# Inclure les configurations par défaut de Debian (raccourcis médias, polkit, etc.)
include /etc/sway/config.d/*

# Variables d'environnement essentielles pour Wayland (Firefox, Qt, Écran)
# Les variables d'environnement sont importées par /etc/sway/config.d/50-systemd-user.conf

# Fond de secours persistant (restaure a chaque reload/login, la rotation l'ecrase au runtime)
output * bg ~/Images/waves.png fill

# Wallpaper aleatoire a l'ouverture de session
exec ~/.local/bin/sway-next-wallpaper.sh

# Verr Maj actif par defaut (touche utilisable pour deverrouiller)
exec sh -c 'sleep 2; wtype -k Caps_Lock'
exec mako

# Waybar en barre pleine (exclusive, reserve l'espace pour les fenetres)
exec waybar

# Demon de surveillance du presse-papier (texte + images pour cliphist)
exec ~/.local/bin/cliphist-daemon.sh

# --- RACCOURCIS CLAVIER ---

# Raccourcis de base
bindsym $mod+Return exec $term
bindsym $mod+o exec foot -e /home/bison/.local/bin/cdd-opencode.sh
bindsym $mod+w kill
bindsym $mod+space exec $menu
bindsym $mod+l exec swaylock
bindsym $mod+exclam exec ~/.local/bin/sway-next-wallpaper.sh
bindsym $mod+Shift+e exec swaynag -t warning -m 'Voulez-vous quitter Sway ?' -B 'Oui, quitter' 'swaymsg exit'

# Historique du presse-papier façon Windows 11 (Tofi)
bindsym Control+Shift+v exec ~/.local/bin/cliphist-tofi.sh
bindsym $mod+Shift+v exec ~/.local/bin/cliphist-tofi.sh

# Capture d'écran avec recadrage façon Windows 11 (Win + Maj + S et Print)
bindsym $mod+Shift+s exec ~/.local/bin/screenshot-area.sh
bindsym Print exec ~/.local/bin/screenshot-area.sh

# Déplacer le focus (touches fléchées ou hjkl)
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Changement de bureau circulaire (1-2-3-4-5-1) au clavier
bindsym Control+$mod+Left exec ~/.local/bin/sway-cycle-workspace.sh prev
bindsym Control+$mod+Right exec ~/.local/bin/sway-cycle-workspace.sh next

# Déplacer la fenêtre active
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Gestures trackpad : 3 doigts = bureau circulaire
bindgesture swipe:3:left exec ~/.local/bin/sway-cycle-workspace.sh next
bindgesture swipe:3:right exec ~/.local/bin/sway-cycle-workspace.sh prev

# Gestion des Workspaces (Pavé Numérique 1 à 5)
# Changer de vue uniquement (Super + Pavé Numérique 1 à 5)
bindsym $mod+KP_1 workspace number 1
bindsym $mod+KP_End workspace number 1
bindsym $mod+KP_2 workspace number 2
bindsym $mod+KP_Down workspace number 2
bindsym $mod+KP_3 workspace number 3
bindsym $mod+KP_Next workspace number 3
bindsym $mod+KP_4 workspace number 4
bindsym $mod+KP_Left workspace number 4
bindsym $mod+KP_5 workspace number 5
bindsym $mod+KP_Begin workspace number 5

# Déplacer la fenêtre active (Super + Shift + Pavé Numérique 1 à 5)
bindsym $mod+Shift+KP_1 exec ~/.local/bin/sway-move-to-ws.sh 1
bindsym $mod+Shift+KP_End exec ~/.local/bin/sway-move-to-ws.sh 1
bindsym $mod+Shift+KP_2 exec ~/.local/bin/sway-move-to-ws.sh 2
bindsym $mod+Shift+KP_Down exec ~/.local/bin/sway-move-to-ws.sh 2
bindsym $mod+Shift+KP_3 exec ~/.local/bin/sway-move-to-ws.sh 3
bindsym $mod+Shift+KP_Next exec ~/.local/bin/sway-move-to-ws.sh 3
bindsym $mod+Shift+KP_4 exec ~/.local/bin/sway-move-to-ws.sh 4
bindsym $mod+Shift+KP_Left exec ~/.local/bin/sway-move-to-ws.sh 4
bindsym $mod+Shift+KP_5 exec ~/.local/bin/sway-move-to-ws.sh 5
bindsym $mod+Shift+KP_Begin exec ~/.local/bin/sway-move-to-ws.sh 5

# Mise en page (Layouts)
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle

# Recharger la configuration

bindsym $mod+Shift+r reload

# Syncthing est géré par ~/.config/systemd/user/syncthing.service

